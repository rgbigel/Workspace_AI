{
  "meta": {
    "module": "Fix_S1E01.json",
    "path": ".copilot/Fixes/Fix_S1E01.json",
    "version": "1.0.0",
    "config_type": "copilot-fix-module",
    "description": "Step 1 Engine Normalization Fix",
    "authors": ["Workspace_AC Engine"],
    "changelog": [
      "1.0.0 - Initial normalized version aligned with Unified JsonRules"
    ]
  },

  "id": "Fix_S1E01",
  "type": "fix-module",
  "scope": [
    "repository",
    "workspace"
  ],

  "requires": {
    "atoms": [
      "CMD.atom",
      "JSON.atom",
      "PowerShell.atom",
      "invariant.atom"
    ],
    "methods": [
      "LoadRules.ps1",
      "LoadAtoms.ps1",
      "LoadFixes.ps1",
      "LoadMethods.ps1"
    ],
    "rules": [
      "CMDRules.md",
      "JSONRules.md",
      "PowerShellRules.md",
      "InvariantRules.md"
    ]
  },

  "actions": [
    {
      "id": "NormalizePowerShell",
      "type": "normalize-script-header",
      "target": "*.ps1",
      "rules": "PowerShellRules.md",
      "atoms": "PowerShell.atom"
    },
    {
      "id": "NormalizeJSON",
      "type": "normalize-json",
      "target": "*.json",
      "rules": "JSONRules.md",
      "atoms": "JSON.atom"
    },
    {
      "id": "NormalizeCMD",
      "type": "normalize-cmd",
      "target": "*.cmd",
      "rules": "CMDRules.md",
      "atoms": "CMD.atom"
    },
    {
      "id": "ApplyInvariants",
      "type": "apply-invariants",
      "target": "**/*",
      "rules": "InvariantRules.md",
      "atoms": "invariant.atom"
    }
  ],

  "logging": {
    "enabled": true,
    "path": ".copilot/Logs/Fix_S1E01.log"
  }
}
