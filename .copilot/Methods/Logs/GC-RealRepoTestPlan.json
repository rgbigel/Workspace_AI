  "repository_lifecycle_policy": {
    "registry_location": "Workspace_GC",
    "inside_workspace_parent_is_not_sufficient_for_operation": true,
    "states": [
      {
        "id": "discovered-only",
        "operation_allowed": false,
        "description": "Repository exists under the workspace parent but has no governance eligibility decision."
      },
      {
        "id": "blocked-do-not-operate",
        "operation_allowed": false,
        "description": "Repository is intentionally not operated on, for example a copied GitHub repo or other excluded working copy."
      },
      {
        "id": "candidate",
        "operation_allowed": false,
        "description": "Repository is selected for possible read-only dry-run, but dry-run is not enabled."
      },
      {
        "id": "read-only-dry-run",
        "operation_allowed": "read-only-observation-only",
        "description": "Repository may be inspected only through explicitly enabled read-only dry-run commands."
      },
      {
        "id": "external-intake",
        "operation_allowed": "structure-place-analyze-propose-only",
        "description": "External code is used to create or populate a repository skeleton according to Workspace rules, place incoming code into the correct locations, analyze the code, identify atoms and functional problems, create target-local Markdown proposals, and stop for review before remediation."
      },
      {
        "id": "cleanup-candidate",
        "operation_allowed": "proposal-only",
        "description": "Repository may be assessed for keep, block, archive, move, or delete proposals; destructive action requires explicit acceptance."
      },
      {
        "id": "active-governed",
        "operation_allowed": "after-explicit-accept",
        "description": "Repository may receive approved documentation or code changes through the current accepted step only."
      },
      {
        "id": "retired",
        "operation_allowed": false,
        "description": "Repository is intentionally no longer operated on by Workspace_GC."
      }
    ],
    "external_code_policy": {
      "outside_code_is_evidence_not_authority": true,
      "new_repo_import_requires_intake": true,
      "intake_may_create_repo_skeleton": true,
      "intake_places_code_before_analysis": true,
      "intake_identifies_atoms": true,
      "intake_identifies_functional_problems": true,
      "intake_stops_for_review_before_remediation": true,
      "new_outside_version_requires_comparison_before_adoption": true,
      "adoption_requires_tests_or_documented_test_absence": true,
      "adoption_requires_user_accept": true
    },
