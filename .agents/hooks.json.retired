{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "description": "LCM Deterministic Hook Engine configuration for Antigravity and Gemini CLI.",
  "hooks": {
    "PreToolUse": [
      {
        "name": "LCM-PreToolPolicyEnforcer",
        "description": "Deterministically validates tool arguments, git commit/push gating, and boundary isolation.",
        "command": "pwsh.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy", "Bypass",
          "-File", "D:\\Git_Repositories\\.lcm\tools\hooks\Enforce-LcmPreToolPolicy.ps1"
        ],
        "timeoutSeconds": 5
      }
    ],
    "PostToolUse": [
      {
        "name": "LCM-PostToolAuditAndLint",
        "description": "Performs AST syntax verification and records deterministic audit logs.",
        "command": "pwsh.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy", "Bypass",
          "-File", "D:\\Git_Repositories\\.lcm\tools\hooks\Enforce-LcmPostToolPolicy.ps1"
        ],
        "timeoutSeconds": 5
      }
    ],
    "SessionStart": [
      {
        "name": "LCM-SessionAudit",
        "description": "Audits repository rule junctions and hardware invariants on startup.",
        "command": "pwsh.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy", "Bypass",
          "-File", "D:\\Git_Repositories\\.lcm\tools\hooks\Invoke-LcmSessionAudit.ps1"
        ],
        "timeoutSeconds": 10
      }
    ]
  }
}





