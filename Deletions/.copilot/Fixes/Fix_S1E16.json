{
  "meta": {
    "module": "Fix_S1E16.json",
    "path": ".copilot/Fixes/Fix_S1E16.json",
    "version": "1.0.0",
    "config_type": "copilot-fix-module",
    "description": "Step 1 Engine Terminal Uniform Compliance Pass (Substep 16)",
    "authors": ["Workspace_GC Engine"],
    "changelog": [
      "1.0.0 - Added terminal uniform compliance pass for Step 1 Engine"
    ]
  },

  "id": "Fix_S1E16",
  "type": "fix-module",
  "scope": [
    "repository",
    "workspace"
  ],

  "requires": {
    "atoms": [
      "JSON.atom",
      "PowerShell.atom",
      "CMD.atom",
      "invariant.atom"
    ],
    "methods": [
      "LoadRules.ps1",
      "LoadAtoms.ps1",
      "LoadFixes.ps1",
      "LoadMethods.ps1"
    ],
    "rules": [
      "JSONRules.md",
      "PowerShellRules.md",
      "CMDRules.md",
      "InvariantRules.md"
    ]
  },

  "actions": [
    {
      "id": "ComplianceJSON",
      "type": "quality-check",
      "target": "*.json",
      "rules": "JSONRules.md",
      "atoms": "JSON.atom"
    },
    {
      "id": "CompliancePS1",
      "type": "quality-check",
      "target": "*.ps1",
      "rules": "PowerShellRules.md",
      "atoms": "PowerShell.atom"
    },
    {
      "id": "ComplianceCMD",
      "type": "quality-check",
      "target": "*.cmd",
      "rules": "CMDRules.md",
      "atoms": "CMD.atom"
    },
    {
      "id": "ComplianceInvariant",
      "type": "quality-check",
      "target": "**/*",
      "rules": "InvariantRules.md",
      "atoms": "invariant.atom"
    }
  ],

  "logging": {
    "enabled": true,
    "path": ".copilot/Logs/Fix_S1E16.log"
  }
}
